<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/materialdesign">
    
    <!-- Cyberpunk Color Palette -->
    <SolidColorBrush x:Key="CyberpunkDarkBg" Color="#0B0E14" />
    <SolidColorBrush x:Key="CyberpunkNeonCyan" Color="#7CF6C4" />
    <SolidColorBrush x:Key="CyberpunkDeepBlue" Color="#15253E" />
    <SolidColorBrush x:Key="CyberpunkLightText" Color="#E0E0E0" />
    <SolidColorBrush x:Key="CyberpunkMutedText" Color="#999999" />
    <SolidColorBrush x:Key="CyberpunkGlowRed" Color="#FF5555" />
    <SolidColorBrush x:Key="CyberpunkGlowGreen" Color="#55FF55" />
    
    <!-- Main Window Background -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0E14" />
    
    <!-- Card Styles (XAML-based alternative to MaterialCard) -->
    <Style x:Key="CyberpunkCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A1F2E" />
        <Setter Property="BorderBrush" Value="#7CF6C4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="8" />
    </Style>
    
    <!-- Tab Header Styling -->
    <Style x:Key="CyberpunkTabItemStyle" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border Name="Border" 
                                Background="#1A1F2E"
                                BorderBrush="#444444"
                                BorderThickness="0,0,0,2"
                                Padding="16,12">
                            <ContentPresenter ContentSource="Header" 
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            TextElement.Foreground="#999999" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#7CF6C4" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,3" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#555555" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#999999" />
    </Style>
    
    <!-- Button Styling -->
    <Style x:Key="CyberpunkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#15253E" />
        <Setter Property="Foreground" Value="#7CF6C4" />
        <Setter Property="BorderBrush" Value="#7CF6C4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#7CF6C4" />
                            <Setter Property="Foreground" Value="#0B0E14" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#55B89F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- TextBox Styling -->
    <Style x:Key="CyberpunkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#1A1F2E" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="BorderBrush" Value="#444444" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontFamily" Value="Consolas, Courier New" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    
    <!-- ListBox Styling -->
    <Style x:Key="CyberpunkListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="#1A1F2E" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="BorderBrush" Value="#444444" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ComboBox Styling -->
    <Style x:Key="CyberpunkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="#1A1F2E" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="BorderBrush" Value="#7CF6C4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#1A1F2E" />
                    <Setter Property="Foreground" Value="#E0E0E0" />
                    <Setter Property="Padding" Value="8,6" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#0F6B4F" />
                            <Setter Property="Foreground" Value="#E0E0E0" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#15253E" />
                            <Setter Property="Foreground" Value="#7CF6C4" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Checkbox Styling -->
    <Style x:Key="CyberpunkCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Border x:Name="CheckBoxBorder"
                                Width="18"
                                Height="18"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="#7CF6C4"
                                Background="#15253E"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CheckMark" 
                                     Text="✓" 
                                     Foreground="#7CF6C4"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Opacity="0" />
                        </Border>
                        
                        <ContentPresenter Grid.Column="1" 
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True" />
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0F6B4F" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#9FE8C8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>