<Window x:Class="ENIAC.Tuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ENIAC System Tuner"
        Height="700"
        Width="1100"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#15253E" Offset="0"/>
            <GradientStop Color="#103A2E" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#21314B"/>
            <Setter Property="Foreground" Value="#F0F4FA"/>
            <Setter Property="BorderBrush" Value="#3A567A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C121D"/>
            <Setter Property="Foreground" Value="#DDE7F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeroBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ENIAC SYSTEM TUNER" FontSize="30" FontWeight="Bold" Foreground="#7CF6C4"/>
                    <TextBlock Text="Otimizador profissional para Windows com arquitetura segura" Foreground="#C3D0E2" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1B2B43" Padding="14,8" CornerRadius="20" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AdminText}" Foreground="#F2F7FF" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#111A29" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="Analisar Sistema" Width="160" Click="AnalyzeButton_Click" IsEnabled="{Binding CanRunOperations}"/>
                <Button Content="Diagnostico Detalhado" Width="190" Click="DeepAnalyzeButton_Click" IsEnabled="{Binding CanRunOperations}"/>
                <Button Content="Otimizacao Segura" Width="180" Click="SafeOptimizeButton_Click" IsEnabled="{Binding CanRunOperations}"/>
                <Button Content="Otimizacao de Rede" Width="180" Click="NetworkOptimizeButton_Click" IsEnabled="{Binding CanRunOperations}"/>
                <Button Content="Hardcore" Width="120" Click="HardcoreOptimizeButton_Click" IsEnabled="{Binding CanRunOperations}" Background="#3D2B10" BorderBrush="#C87A20"/>
                <Button Content="EXTREMO" Width="110" Click="ExtremeOptimizeButton_Click" IsEnabled="{Binding CanRunOperations}" Background="#3B1010" BorderBrush="#C82020" Foreground="#FF9090"/>
                <Button Content="Reverter" Width="110" Click="RollbackButton_Click" IsEnabled="{Binding HasRollback}" Background="#1A2B3D" BorderBrush="#3A80C8" ToolTip="{Binding LastProfileName, StringFormat=Reverter: {0}}"/>
                <Button Content="Cancelar" Width="110" Click="CancelButton_Click" IsEnabled="{Binding IsBusy}" Background="#5A2531" BorderBrush="#8E3B4D"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111A29" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Resumo" FontWeight="Bold" Foreground="#E8F0FC" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding SummaryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="410"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#111A29" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Log de operacoes" FontWeight="Bold" Foreground="#E8F0FC" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="410"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#111A29" CornerRadius="12" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#C6D3E6" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <ProgressBar Grid.Column="1"
                             Height="16"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Margin="12,0,12,0"
                             Foreground="#62E3AF"
                             Background="#24344D"/>

                <TextBlock Grid.Column="2" Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" Foreground="#EAF1FC" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
